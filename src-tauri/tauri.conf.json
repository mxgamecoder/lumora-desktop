{
  "productName": "Lumora 1.3",
  "version": "1.3.0",
  "identifier": "com.lumora.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node copy-web-assets.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "Lumora 1.3",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0f0f1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "© 2025 Lumora. All rights reserved.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNkRGNEM0NzBFMzRGOUEKUldTYVQrTnd4UFJ0YTIwMk5VQVN0ZmQ5RE9FUklzVmdsRm4yNjlKeEpsdmlNWDJJaDJlaEEwU0UK",
      "endpoints": ["https://api.lumorapp.name.ng/api/app-version/manifest"]
    }
  }
}